---
import SiteLayout from '../layouts/SiteLayout.astro';
import { company } from '../data/site';
---

<SiteLayout title="Contacto" description="Contacta con Irvanta TECH para consultas, presupuestos y proyectos de tecnología, datos, automatización e inteligencia artificial." activeHref="/contact/">
  <section class="contact-future">
    <div class="contact-future__grid" aria-hidden="true"></div>
    <div class="content-shell contact-future__layout">
      <div class="contact-future__intro">
        <p class="eyebrow"><span>CONTACTO / IRVANTA TECH</span></p>
        <h1>Hablemos de<br /><span>lo que viene.</span></h1>
        <p>Cuéntanos qué necesitas. Nuestro equipo te responderá para conocer tu consulta y orientarte sobre el siguiente paso.</p>
        <div class="contact-future__email">
          <span>CONTACTO CORPORATIVO</span>
          <a href={`mailto:${company.email}`}>{company.email}<span aria-hidden="true">↗</span></a>
        </div>
        <a class="linkedin-link linkedin-link--contact" href="https://www.linkedin.com/company/irvanta-tech" target="_blank" rel="noopener noreferrer" aria-label="Irvanta Tech en LinkedIn (se abre en una pestaña nueva)">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.85-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.354V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.268 2.37 4.268 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
          <span>Irvanta Tech | LinkedIn</span>
        </a>
        <div class="contact-future__availability"><span aria-hidden="true"></span> Un equipo preparado para ayudarte</div>
      </div>

      <form class="contact-future__form" data-contact-form>
        <div class="contact-future__form-heading">
          <span>INICIAR UNA CONVERSACIÓN</span>
          <span>01 — 04</span>
        </div>
        <label>
          ¿En qué podemos ayudarte?
          <select name="topic" required>
            <option value="" disabled selected>Selecciona el motivo de contacto</option>
            <option value="Consulta general">Consulta general</option>
            <option value="Presupuesto">Solicitar presupuesto</option>
            <option value="Desarrollo web">Desarrollo web</option>
            <option value="Software a medida">Software a medida</option>
            <option value="Datos e inteligencia artificial">Datos e inteligencia artificial</option>
            <option value="Automatización">Automatización</option>
            <option value="Consultoría tecnológica">Consultoría tecnológica</option>
            <option value="Otro">Otro</option>
          </select>
        </label>
        <div class="contact-future__fields">
          <label>Nombre<input name="name" autocomplete="name" placeholder="Tu nombre" required /></label>
          <label>Correo electrónico<input name="email" type="email" autocomplete="email" placeholder="nombre@empresa.com" required /></label>
        </div>
        <label>Cuéntanos brevemente<textarea name="message" rows="4" placeholder="¿Qué reto te gustaría resolver?" required></textarea></label>
        <button class="contact-future__submit" type="submit">
          <span data-submit-label>Enviar formulario</span>
          <span aria-hidden="true">↗</span>
        </button>
        <p class="contact-future__note" data-contact-status role="status" aria-live="polite">Al enviar, tu consulta llegará directamente a nuestro equipo.</p>
      </form>
    </div>
    <div class="contact-future__footer content-shell" aria-hidden="true"><span>TECNOLOGÍA CON PROPÓSITO</span><span>IRVANTA TECH · EST. 2026</span></div>
  </section>
</SiteLayout>

<script>
  import emailjs from '@emailjs/browser';

  const emailjsServiceId = 'IrvantaTech';
  const emailjsTemplateId = 'IrvantaTemplate';
  const emailjsPublicKey = 't4fkUKvk-v_axvi7g';
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const topic = new FormData(form).get('topic');

    if (!submitButton || !submitLabel || !status) {
      throw new Error('No se ha podido preparar el formulario de contacto.');
    }

    if (typeof topic !== 'string' || !topic) {
      status.classList.add('is-error');
      status.textContent = 'Selecciona el motivo de contacto antes de enviar el formulario.';
      return;
    }

    submitButton.disabled = true;
    submitLabel.textContent = 'Enviando...';
    status.classList.remove('is-success', 'is-error');
    status.textContent = 'Enviando tu consulta...';

    try {
      await emailjs.sendForm(emailjsServiceId, emailjsTemplateId, form, {
        publicKey: emailjsPublicKey,
      });
    } catch (error) {
      console.error('No se ha podido enviar el formulario de contacto.', error);
      status.classList.add('is-error');
      status.textContent = 'No hemos podido enviar tu consulta. Inténtalo de nuevo o contacta con nosotros por correo electrónico.';
      return;
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = 'Enviar formulario';
    }

    form.reset();
    status.classList.add('is-success');
    status.textContent = 'Hemos recibido tu mensaje correctamente. Nos pondremos en contacto contigo lo antes posible. Gracias por contactar con Irvanta TECH.';
    window.dispatchEvent(new CustomEvent('irvanta:contact-request', { detail: { topic } }));
  });
</script>
