---
import SiteLayout from '../layouts/SiteLayout.astro';
import { company } from '../data/site';
import { withBase } from '../utils/paths';
---

<SiteLayout title="Inicio" description="Irvanta TECH diseña y desarrolla soluciones digitales, automatización y tecnología a medida para empresas que quieren crecer con criterio." activeHref="/">
	<section class="home-hero">
		<div class="home-hero__background" aria-hidden="true">
			<div class="hero-orb hero-orb--one"></div>
			<div class="hero-orb hero-orb--two"></div>
			<div class="hero-grid"></div>
			<div class="hero-lines"></div>
		</div>
		<div class="content-shell home-hero__inner">
			<div class="home-hero__copy">
				<p class="eyebrow eyebrow--light"><span>ESTRATEGIA / INGENIERÍA / PRODUCTO</span></p>
				<h1>Tecnología que convierte ideas en soluciones.</h1>
				<p class="home-hero__statement">Desarrollamos soluciones digitales, automatización y tecnología a medida para ayudar a empresas a trabajar mejor, crecer y adaptarse a un entorno cada vez más digital.</p>
				<div class="hero-actions">
					<a class="button button--signal" href={withBase('/contact')}>Solicitar presupuesto <span aria-hidden="true">↗</span></a>
					<a class="text-link text-link--light" href="#servicios">Ver servicios <span aria-hidden="true">↓</span></a>
				</div>
			</div>
			<div class="home-hero__aside" aria-label="Resumen de capacidades">
				<div class="metric-card">
					<span>01</span>
					<strong>Soluciones a medida</strong>
				</div>
				<div class="metric-card">
					<span>02</span>
					<strong>Automatización útil</strong>
				</div>
				<div class="metric-card">
					<span>03</span>
					<strong>Datos y decisiones</strong>
				</div>
			</div>
		</div>
	</section>

	<section class="home-section home-services content-shell" id="servicios">
		<div class="section-header">
			<p class="eyebrow"><span>¿QUÉ HACEMOS?</span></p>
			<h2>Soluciones digitales que encajan con tu negocio.</h2>
		</div>
		<div class="services-grid">
			<article class="service-card">
				<span class="service-card__number">01</span>
				<h3>Desarrollo de software</h3>
				<p>Aplicaciones y herramientas adaptadas a las necesidades de cada empresa.</p>
			</article>
			<article class="service-card">
				<span class="service-card__number">02</span>
				<h3>Automatización</h3>
				<p>Automatización de procesos repetitivos para ahorrar tiempo y reducir errores.</p>
			</article>
			<article class="service-card">
				<span class="service-card__number">03</span>
				<h3>Datos &amp; Analytics</h3>
				<p>Transformación de datos en información útil para tomar mejores decisiones.</p>
			</article>
			<article class="service-card">
				<span class="service-card__number">04</span>
				<h3>Inteligencia Artificial</h3>
				<p>Integración de IA en procesos, productos y herramientas empresariales.</p>
			</article>
			<article class="service-card">
				<span class="service-card__number">05</span>
				<h3>Web &amp; Digital</h3>
				<p>Diseño y desarrollo de páginas web y plataformas digitales.</p>
			</article>
			<article class="service-card">
				<span class="service-card__number">06</span>
				<h3>Consultoría tecnológica</h3>
				<p>Análisis de necesidades y diseño de soluciones tecnológicas.</p>
			</article>
		</div>
	</section>

	<section class="home-section home-why">
		<div class="content-shell why-grid">
			<div class="why-copy">
				<p class="eyebrow"><span>¿POR QUÉ IRVANTA TECH?</span></p>
				<h2>Tecnología adaptada a tu negocio.</h2>
			</div>
			<div class="why-points">
				<div class="why-point">
					<span>01</span>
					<h3>Soluciones a medida</h3>
				</div>
				<div class="why-point">
					<span>02</span>
					<h3>Tecnología escalable</h3>
				</div>
				<div class="why-point">
					<span>03</span>
					<h3>Automatización de procesos</h3>
				</div>
				<div class="why-point">
					<span>04</span>
					<h3>Enfoque práctico y orientado a resultados</h3>
				</div>
			</div>
		</div>
	</section>

	<section class="home-section home-process">
		<div class="content-shell">
			<div class="section-header section-header--center">
				<p class="eyebrow"><span>Cómo trabajamos</span></p>
				<h2>Un proceso claro para transformar ideas en realidad.</h2>
			</div>
			<div class="process-grid">
				<article class="process-card">
					<span class="process-card__step">01 — Analizamos</span>
					<p>Entendemos el problema y las necesidades del negocio.</p>
				</article>
				<article class="process-card">
					<span class="process-card__step">02 — Diseñamos</span>
					<p>Definimos la solución y la tecnología necesaria.</p>
				</article>
				<article class="process-card">
					<span class="process-card__step">03 — Desarrollamos</span>
					<p>Construimos, integramos y probamos la solución.</p>
				</article>
				<article class="process-card">
					<span class="process-card__step">04 — Evolucionamos</span>
					<p>Mantenemos y mejoramos la solución según las necesidades futuras.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="home-section home-portfolio">
		<div class="content-shell">
			<div class="section-header section-header--split">
				<p class="eyebrow"><span>Portfolio destacado</span></p>
				<h2>Trabajos con propósito y enfoque práctico.</h2>
				<a class="text-link" href={withBase('/about')}>Ver casos <span aria-hidden="true">↗</span></a>
			</div>
			<div class="portfolio-grid">
				<article class="project-card">
					<div class="project-card__visual project-card__visual--one" aria-hidden="true"></div>
					<div class="project-card__body">
						<div class="project-card__meta"><span>Dashboard</span><span>2026</span></div>
						<h3>Panel de operaciones</h3>
						<p>Visibilidad real del negocio con reportes, KPI y automatizaciones para decisiones más rápidas.</p>
						<a class="text-link" href={withBase('/about')}>Ver caso <span aria-hidden="true">↗</span></a>
					</div>
				</article>
				<article class="project-card">
					<div class="project-card__visual project-card__visual--two" aria-hidden="true"></div>
					<div class="project-card__body">
						<div class="project-card__meta"><span>Automatización</span><span>2026</span></div>
						<h3>Flujos internos</h3>
						<p>Reducción de tareas repetitivas y mejor coordinación entre equipos mediante procesos conectados.</p>
						<a class="text-link" href={withBase('/about')}>Ver caso <span aria-hidden="true">↗</span></a>
					</div>
				</article>
				<article class="project-card">
					<div class="project-card__visual project-card__visual--three" aria-hidden="true"></div>
					<div class="project-card__body">
						<div class="project-card__meta"><span>Web</span><span>2026</span></div>
						<h3>Plataforma digital B2B</h3>
						<p>Experiencia digital clara para vender, gestionar y acompañar clientes con una base escalable.</p>
						<a class="text-link" href={withBase('/about')}>Ver caso <span aria-hidden="true">↗</span></a>
					</div>
				</article>
				<article class="project-card">
					<div class="project-card__visual project-card__visual--four" aria-hidden="true"></div>
					<div class="project-card__body">
						<div class="project-card__meta"><span>IA</span><span>2026</span></div>
						<h3>Asistente de negocio</h3>
						<p>Integración de IA para extraer información, resumir tareas y acelerar análisis sin perder control.</p>
						<a class="text-link" href={withBase('/about')}>Ver caso <span aria-hidden="true">↗</span></a>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="home-contact" id="contacto">
		<div class="content-shell home-contact__inner">
			<div>
				<p class="eyebrow eyebrow--light"><span>CONTACTO</span></p>
				<h2>¿Tienes una idea o un problema que podamos resolver?</h2>
				<p class="home-contact__text">Hablemos y encontremos la solución adecuada para tu negocio.</p>
			</div>
			<div class="home-contact__actions">
				<a class="button button--signal" href={`mailto:${company.email}`}>Contactar con Irvanta TECH <span aria-hidden="true">↗</span></a>
				<a class="text-link text-link--light" href={`mailto:${company.email}`}>{company.email}</a>
			</div>
		</div>
	</section>
</SiteLayout>
