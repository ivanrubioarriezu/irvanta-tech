---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieNotice from '../components/CookieNotice.astro';
import Analytics from '../components/Analytics.astro';
import { company, navigation } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  activeHref?: string;
  redirectTo?: string;
  redirectDelay?: number;
}

const { title, description, activeHref = '', redirectTo, redirectDelay = 5 } = Astro.props;
const navigationItems = navigation.map((item) => ({ ...item, href: withBase(item.href) }));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071426" />
    <meta name="generator" content={Astro.generator} />
    {redirectTo && <meta http-equiv="refresh" content={`${redirectDelay};url=${withBase(redirectTo)}`} />}
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} · {company.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <SiteHeader items={navigationItems} activeHref={activeHref ? withBase(activeHref) : ''} />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <CookieNotice />
    <Analytics />
  </body>
</html>