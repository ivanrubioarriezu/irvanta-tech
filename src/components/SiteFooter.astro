---
import { company, legalNavigation, socialLinks } from '../data/site';
import { withBase } from '../utils/paths';
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="wordmark wordmark--footer" href={withBase('/')} aria-label="Irvanta TECH, inicio">
        <img class="wordmark__mark" src={withBase('/media/Irvanta%20Tech%20Logo.png')} alt="" width="352" height="352" />
        <span class="wordmark__name">IRVANTA<span>TECH</span></span>
      </a>
      <p>Tecnología con criterio.<br />Ejecución con intención.</p>
    </div>
    <div class="footer-column">
      <p class="footer-label">Legal</p>
      {legalNavigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </div>
    <div class="footer-column">
      <p class="footer-label">Contacto</p>
      <a href={withBase('/contact')}>Iniciar una conversación ↗</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </div>
    <div class="footer-column">
      <p class="footer-label">Redes sociales</p>
      {socialLinks.length ? socialLinks.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label} ↗</a>) : <span class="footer-pending">En preparación</span>}
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {company.year} Irvanta TECH</span>
    <span>Diseñado para avanzar.</span>
  </div>
</footer>