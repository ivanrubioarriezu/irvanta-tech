---
import { company, legalNavigation } from '../data/site';
import { withBase } from '../utils/paths';
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="wordmark wordmark--footer" href={withBase('/')} aria-label="Irvanta TECH, inicio">
        <img class="wordmark__mark" src={withBase('/media/Irvanta%20Tech%20Logo.png')} alt="" width="352" height="352" />
        <span class="wordmark__name">IRVANTA<span>TECH</span></span>
      </a>
      <p>Tecnología con criterio.<br />Ejecución con intención.</p>
    </div>
    <div class="footer-column">
      <p class="footer-label">Legal</p>
      {legalNavigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </div>
    <div class="footer-column footer-contact">
      <p class="footer-label">Contacto</p>
      <a href={withBase('/contact/')}>Iniciar una conversación ↗</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a class="linkedin-link linkedin-link--footer" href="https://www.linkedin.com/company/irvanta-tech" target="_blank" rel="noopener noreferrer" aria-label="Irvanta Tech en LinkedIn (se abre en una pestaña nueva)">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.85-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.354V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.268 2.37 4.268 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
        <span>Irvanta Tech | LinkedIn</span>
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {company.year} Irvanta TECH</span>
    <span>Tecnología para ir un paso más allá</span>
    <button type="button" data-cookie-settings>Preferencias de cookies</button>
  </div>
</footer>