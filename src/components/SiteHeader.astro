---
import { withBase } from '../utils/paths';

interface Props {
  items: { label: string; href: string }[];
  activeHref?: string;
}

const { items, activeHref = '' } = Astro.props;
const isContactPage = activeHref === withBase('/contact');
---

<header class="site-header">
  <a class="wordmark" href={withBase('/')} aria-label="Irvanta TECH, inicio">
    <span class="wordmark__mark" aria-hidden="true">I</span>
    <span class="wordmark__name">IRVANTA<span>TECH</span></span>
  </a>
  <nav class="desktop-nav" aria-label="Navegación principal">
    {items.map((item) => (
      <a href={item.href} aria-current={activeHref === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  {!isContactPage && <a class="header-contact" href={withBase('/contact')}>Hablemos <span aria-hidden="true">↗</span></a>}
  <details class="mobile-menu">
    <summary aria-label="Abrir menú"><span></span><span></span></summary>
    <nav aria-label="Navegación móvil">
      {items.map((item) => (
        <a href={item.href} aria-current={activeHref === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      {!isContactPage && <a class="mobile-menu__cta" href={withBase('/contact')}>Hablemos ↗</a>}
    </nav>
  </details>
</header>