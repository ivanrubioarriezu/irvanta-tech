---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---

{measurementId && (
  <script define:vars={{ measurementId }}>
    const pageConsent = () => document.cookie.split('; ').some((cookie) => cookie === 'irvanta_consent=v1.analytics.1');
    const clearGoogleAnalyticsCookies = () => {
      const secureAttribute = window.location.protocol === 'https:' ? '; Secure' : '';
      const googleCookieNames = document.cookie
        .split('; ')
        .map((cookie) => cookie.split('=')[0])
        .filter((name) => name === '_ga' || name === '_gid' || name === '_gat' || name.startsWith('_ga_'));

      for (const name of googleCookieNames) {
        document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax${secureAttribute}`;
        document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax; Domain=${window.location.hostname}${secureAttribute}`;
      }
    };

    const analyticsWindow = window;
    let analyticsLoaded = false;

    const disableAnalytics = () => {
      if (analyticsLoaded) {
        analyticsWindow.gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }
      clearGoogleAnalyticsCookies();
    };

    const enableAnalytics = () => {
      if (!pageConsent()) {
        disableAnalytics();
        return;
      }

      if (!/^G-[A-Z0-9]+$/.test(measurementId)) {
        console.error('Google Analytics no se ha cargado: el ID de medición configurado no es válido.');
        return;
      }

      if (!analyticsLoaded) {
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.gtag = (...args) => analyticsWindow.dataLayer.push(args);
        analyticsWindow.gtag('js', new Date());
        analyticsWindow.gtag('consent', 'default', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        analyticsWindow.gtag('config', measurementId, {
          send_page_view: false,
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.append(script);
        analyticsLoaded = true;
      }

      analyticsWindow.gtag('event', 'page_view', {
        page_title: document.title,
        page_location: `${window.location.origin}${window.location.pathname}`,
        page_path: window.location.pathname,
      });
    };

    if (pageConsent()) enableAnalytics();
    document.addEventListener('irvanta:consent-change', (event) => {
      const consent = event.detail;
      if (consent.analytics) enableAnalytics();
      else disableAnalytics();
    });
    window.addEventListener('irvanta:contact-request', (event) => {
      const topic = event.detail?.topic;
      if (topic && pageConsent() && analyticsLoaded) {
        analyticsWindow.gtag('event', 'contact_request', { contact_topic: topic });
      }
    });
  </script>
)}
